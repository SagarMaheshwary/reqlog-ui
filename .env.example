HTTP_SERVER_URL=localhost:4000
HTTP_SHUTDOWN_TIMEOUT=5s
HTTP_AUTH_API_KEY=
HTTP_GIN_MODE=release
HTTP_LOGGER_ENABLED=1
HTTP_AUTH_JWT_SECRET=
HTTP_HTTPS=false

REQLOG_BINARY_PATH=reqlog
REQLOG_EXECUTION_TIMEOUT=15m
REQLOG_MAX_LINES=5000
REQLOG_SEARCH_CONCURRENCY=5
REQLOG_STREAM_CONCURRENCY=5
REQLOG_ALLOWED_DIRECTORIES=reqlog:/var/log/reqlog
REQLOG_DOCKER_SERVICES_MODE=manual # auto|manual
REQLOG_DOCKER_SERVICES=order-service,inventory-service
